{
  "info": {
    "name": "FMB920 Server API (Railway)",
    "_postman_id": "fmb920-server-api-railway",
    "description": "Postman collection for testing FMB920 Server API endpoints deployed on Railway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Device",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"imei\": \"123456789012345\",\n  \"sim\": \"0712345678\",\n  \"vehicle_no\": \"KBC123A\",\n  \"chassis_no\": \"CH1234567890\"\n}"
        },
        "url": {
          "raw": "https://mytrack-production.up.railway.app/api/devices/create",
          "protocol": "https",
          "host": ["mytrack-production", "up", "railway", "app"],
          "path": ["api", "devices", "create"]
        }
      },
      "response": []
    },
    {
      "name": "List Devices",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://mytrack-production.up.railway.app/api/devices/list",
          "protocol": "https",
          "host": ["mytrack-production", "up", "railway", "app"],
          "path": ["api", "devices", "list"]
        }
      },
      "response": []
    },
    {
      "name": "Get Latest Position",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://mytrack-production.up.railway.app/api/devices/latest?imei=123456789012345",
          "protocol": "https",
          "host": ["mytrack-production", "up", "railway", "app"],
          "path": ["api", "devices", "latest"],
          "query": [
            { "key": "imei", "value": "123456789012345" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Dashboard HTML",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://mytrack-production.up.railway.app/dashboard",
          "protocol": "https",
          "host": ["mytrack-production", "up", "railway", "app"],
          "path": ["dashboard"]
        }
      },
      "response": []
    }
  ]
}
